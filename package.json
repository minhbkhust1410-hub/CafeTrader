{
  "name": "cafe-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/rooms.test.mjs server/wire.test.mjs server/http.test.mjs",
    "test:watch": "node --test --watch server/rooms.test.mjs server/wire.test.mjs server/http.test.mjs",
    "verify": "npm run test && npm run build",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:5173",
    "tunnel:localtunnel": "npx localtunnel --port 5173"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
